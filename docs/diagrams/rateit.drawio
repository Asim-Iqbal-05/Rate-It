        <mxCell id="saQdPtkkA6lJzcS7CsiB-98" parent="saQdPtkkA6lJzcS7CsiB-97" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#232F3E;" value="RateIt AWS Architecture" vertex="1">
          <mxGeometry height="34" width="900" x="60" y="20" as="geometry" />
        </mxCell>
        <mxCell id="saQdPtkkA6lJzcS7CsiB-99" parent="saQdPtkkA6lJzcS7CsiB-97" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#5A6C74;" value="Region us-west-2" vertex="1">
          <mxGeometry height="20" width="900" x="61" y="56" as="geometry" />
        </mxCell>
        <mxCell id="saQdPtkkA6lJzcS7CsiB-101" parent="saQdPtkkA6lJzcS7CsiB-97" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#DD344C;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" value="&lt;b&gt;Security &amp;amp; networking&lt;/b&gt;&lt;br&gt;&lt;br&gt;Both S3 buckets are private (OAC / no public access).&lt;br&gt;&lt;br&gt;API Gateway verifies the Cognito token on every /api/* route, before Lambda or ECS ever sees the request.&lt;br&gt;&lt;br&gt;No public subnets, NAT, or Internet Gateway Lambda reaches AWS services directly (no VPC needed), Fargate only via VPC endpoints.&lt;br&gt;&lt;br&gt;ALB is kept (not Cloud Map) so Feed Service keeps native ECS blue/green deployments.&lt;br&gt;&lt;br&gt;Uploads: presigned POST, tagged pending → claimed; only abandoned pending uploads ever get deleted." vertex="1">
          <mxGeometry height="360" width="190" x="60" y="365" as="geometry" />
        </mxCell>
